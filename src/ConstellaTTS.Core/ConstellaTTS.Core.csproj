<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!--
        Mirror SDK.Audio's WINDOWS define so Core can reference
        platform-specific types from there (e.g. the NAudio-backed
        microphone recorder) inside #if WINDOWS guards. Removing
        this define lets the project build on non-Windows hosts;
        the recorder DI registration drops out automatically.
    -->
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.BuildServices" Version="11.3.2">
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.3" />
        <PackageReference Include="Svg.Skia" Version="4.3.0" />

        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="Xaml.Behaviors" Version="12.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ConstellaTTS.SDK.Audio\ConstellaTTS.SDK.Audio.csproj" />
        <ProjectReference Include="..\ConstellaTTS.SDK.DesignSystem\ConstellaTTS.SDK.DesignSystem.csproj" />
        <ProjectReference Include="..\ConstellaTTS.SDK.IPC\ConstellaTTS.SDK.IPC.csproj" />
        <ProjectReference Include="..\ConstellaTTS.SDK\ConstellaTTS.SDK.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\StatusBarView.axaml.cs">
        <DependentUpon>StatusBarView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Windows\IrreversibleConfirmWindow.axaml.cs">
        <DependentUpon>IrreversibleConfirmWindow.axaml</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
