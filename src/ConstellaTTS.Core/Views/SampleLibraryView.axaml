<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ConstellaTTS.Core.ViewModels"
             xmlns:audio="clr-namespace:ConstellaTTS.SDK.Audio;assembly=ConstellaTTS.SDK.Audio"
             x:Class="ConstellaTTS.Core.Views.SampleLibraryView"
             x:DataType="vm:SampleLibraryViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Row 0: Filter / actions bar ─────────────────────── -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  Margin="10,6"
                  ColumnSpacing="5">

                <TextBox Grid.Column="0"
                         Classes="ctts"
                         PlaceholderText="Ara…"
                         FontSize="11"
                         Padding="7,3"
                         Text="{Binding SearchText}" />

                <Button Grid.Column="1"
                        x:Name="RefreshButton"
                        Width="26" Height="26"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Foreground="{DynamicResource FgMuted}"
                        FontSize="13"
                        Content="↻"
                        Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Sample listesini yenile" />

                <Button Grid.Column="2"
                        x:Name="UploadButton"
                        Padding="8,3"
                        FontSize="10"
                        Background="#1F7C6AF7"
                        BorderBrush="#4C7C6AF7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Foreground="{DynamicResource AccentPurple}"
                        Content="+ Yükle"
                        CommandParameter="{Binding $self}"
                        Command="{Binding UploadSample}"
                        ToolTip.Tip="Dosyadan sample yükle" />

                <Button Grid.Column="3"
                        x:Name="RecordButton"
                        Width="26" Height="26"
                        Padding="0"
                        Background="#14FF60A0"
                        BorderBrush="#59FF60A0"
                        BorderThickness="1"
                        CornerRadius="13"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Command="{Binding ToggleRecordingCommand}"
                        CommandParameter="{Binding $self}"
                        ToolTip.Tip="Kayıt (mikrofon)">
                    <!-- Hollow ring while idle, filled disc while recording.
                         Both shapes always render; opacity bindings flip
                         which one is visible. Ellipse strokes can't be
                         styled cleanly through Avalonia triggers without
                         a converter, so we layer two ellipses instead. -->
                    <Panel Width="10" Height="10">
                        <!-- Idle: 1px stroked ring, no fill -->
                        <Ellipse Width="10" Height="10"
                                 Stroke="{DynamicResource AccentRose}"
                                 StrokeThickness="1.5"
                                 Fill="Transparent"
                                 IsVisible="{Binding !IsRecording}" />
                        <!-- Recording: solid filled disc -->
                        <Ellipse Width="10" Height="10"
                                 Fill="{DynamicResource AccentRose}"
                                 IsVisible="{Binding IsRecording}" />
                    </Panel>
                </Button>

            </Grid>
        </Border>

        <!-- ── Row 1: Sample list ──────────────────────────────── -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Samples}"
                          Padding="6,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="audio:Sample">
                        <Border Margin="0,2"
                                Padding="8,6"
                                Background="{DynamicResource BgSubtle}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                                <TextBlock Grid.Row="0"
                                           Text="{Binding OriginalName}"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource FgPrimary}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <TextBlock FontSize="9"
                                               Foreground="{DynamicResource FgMuted}"
                                               Text="{Binding DurationSec, StringFormat='{}{0:F1}s'}" />
                                    <TextBlock FontSize="9"
                                               Foreground="{DynamicResource FgMuted}"
                                               Text="{Binding SampleRate, StringFormat='{}{0} Hz'}" />
                                    <TextBlock FontSize="9"
                                               Foreground="{DynamicResource FgMuted}"
                                               Text="{Binding Channels, StringFormat='{}{0} ch'}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Row 2: Status bar ───────────────────────────────── -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="10,4"
                IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="9"
                       Foreground="{DynamicResource FgMuted}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

    </Grid>

</UserControl>
